/**
 * Dialect for ElasticSearch 1.x (tested against 1.7)
 *
 * @nowirebox
 */
component extends="BaseDialect" {

// URIS
	public string function getTypeUriSegment( required string type ) {
		return "/#Trim( arguments.type )#";
	}

// FIELD CONFIGURATION AND MAPPINGS
	public string function getDefaultFieldType() {
		return "string";
	}

	public string function translateFieldType( required string type ) {
		switch( arguments.type ) {
			case "text":
			case "keyword":
				return "string";
		}

		return arguments.type;
	}

	public string function getStringFieldType() {
		return "string";
	}

	public struct function buildIndexMappings( required array docTypeMappings ) {
		var mappings = {};

		for( var docTypeMapping in arguments.docTypeMappings ){
			mappings[ docTypeMapping.docType ] = { properties=Duplicate( docTypeMapping.properties ) };
			StructAppend( mappings[ docTypeMapping.docType ].properties, getCommonPropertyMappings(), false );
		}

		return mappings;
	}

// SEARCH
	public string function getDefaultHighlightEncoder() {
		return "html";
	}

	public struct function generateSearchDsl(
		  string  q                = "*"
		, string  fieldList        = ""
		, string  queryFields      = ""
		, string  sortOrder        = ""
		, numeric page             = 1
		, numeric pageOffset       = 0
		, numeric pageSize         = 10
		, string  defaultOperator  = "OR"
		, string  highlightFields  = ""
		, string  highlightEncoder = ""
		, numeric minimumScore     = 0
		, struct  basicFilter      = {}
		, struct  directFilter     = {}
		, string  idList           = ""
		, string  excludeIdList    = ""
	) {
		var body = StructNew();
		var idList = "";

		body['from'] = _calculateStartRecordFromPageInfo( arguments.page, arguments.pageOffset, arguments.pageSize );
		body['size'] = pageSize;
		if ( Len( Trim( arguments.fieldList ) ) ) {
			body['fields'] = ListToArray( arguments.fieldList );
		}
		body['query'] = StructNew();
		body['query']['query_string'] = StructNew();
		body['query']['query_string']['query'] = escapeSpecialChars( arguments.q );
		body['query']['query_string']['default_operator'] = UCase( arguments.defaultOperator );
		if ( Len( Trim( arguments.queryFields ) ) ) {
			body['query']['query_string']['fields'] = ListToArray(arguments.queryFields);
		}

		if ( Len( Trim( arguments.sortOrder ) ) ) {
			body['sort'] = _generateSortOrder( arguments.sortOrder );
		}

		if ( Len( Trim( arguments.highlightFields ) ) ) {
			body['highlight'] = _generateHighlightsDsl( arguments.highlightFields, _resolveHighlightEncoder( arguments.highlightEncoder ) );
		}
		if ( arguments.minimumScore ) {
			body['min_score'] = arguments.minimumScore;
		}

		if ( !StructIsEmpty( arguments.basicFilter ) ) {
			body['filter'] = { 'and' = _generateBasicFilterClauses( arguments.basicFilter ) };
		}

		if ( !StructIsEmpty( arguments.directFilter ) ) {
			body['filter'] = { 'and' = _generateDirectFilterClauses( arguments.directFilter ) };
		}

		if ( StructKeyExists( body, 'filter' ) && !ArrayLen( body.filter['and'] ) ) {
			StructDelete( body, 'filter' );
		}

		if ( Len( Trim( arguments.idList ) ) ) {
			if ( !StructKeyExists( body, 'filter' ) ) {
				body['filter'] = StructNew();
				body['filter']['and'] = ArrayNew(1);
			}

			idList = StructNew();
			idList['ids'] = StructNew();
			idList['ids']['values'] = ListToArray( arguments.idList );

			ArrayAppend( body.filter['and'], idList );
		}
		if ( Len( Trim( arguments.excludeIdList ) ) ) {
			if ( !StructKeyExists( body, 'filter' ) ) {
				body['filter'] = StructNew();
				body['filter']['and'] = ArrayNew(1);
			}

			idList = StructNew();
			idList['not'] = StructNew();
			idList['not']['ids'] = StructNew();
			idList['not']['ids']['values'] = ListToArray( arguments.excludeIdList );

			ArrayAppend( body.filter['and'], idList );
		}

		return body;
	}

	public struct function getMoreLikeThisRequest(
		  required string  baseUri
		, required string  index
		, required string  documentId
		, required struct  dsl
		,          boolean isFullDsl = false
	) {
		var body = arguments.dsl;

		if ( !arguments.isFullDsl ) {
			StructDelete( body, 'query' ); // this will be auto generated by the More Like this engine
		}

		return {
			  uri  = arguments.baseUri & "/#arguments.documentId#/_mlt"
			, body = body
		};
	}

// RESPONSES
	public struct function getHitFields( required struct hit ) {
		return arguments.hit.fields ?: {};
	}

	public struct function parseError( required any error ) {
		var errorType    = ListFirst( arguments.error, "[" );
		var errorMessage = Replace( arguments.error, errorType, "" );

		// strip the square brackets that wrap the message, e.g. IndexMissingException[[foo] missing]
		if ( Len( Trim( errorMessage ) ) > 2 ) {
			errorMessage = Mid( errorMessage, 2, Len( errorMessage) - 2 );
		}

		return {
			  type    = errorType
			, message = errorMessage
		};
	}

// PRIVATE HELPERS
	private struct function _getBaseFieldMapping( required string type, boolean searchable=false, boolean sortable=false, string analyzer="" ) {
		var mapping = { type=arguments.type };

		if ( arguments.searchable ) {
			if ( Len( Trim( arguments.analyzer ) ) ) {
				mapping.analyzer = arguments.analyzer;
			}
		} else {
			if ( arguments.sortable ) {
				mapping.analyzer = "preside_sortable";
			} else {
				mapping.index = "not_analyzed";
			}
		}

		return mapping;
	}
}
